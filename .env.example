# MERIDIAN Environment Configuration Template
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_jwt_secret_for_production

# PostgreSQL Database Configuration
POSTGRES_USER=meridian_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=meridian_db

# Optional: Set DATABASE_URL to use a native PostgreSQL server.
# If omitted, MERIDIAN defaults to embedded zero-config PostgreSQL (PGlite).
# DATABASE_URL=postgresql://meridian_user:replace_with_secure_postgres_password@localhost:5432/meridian_db
